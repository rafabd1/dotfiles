{
  "appearance": {
    "deformScale": 0,
    "anim": {
      "durations": {
        "scale": 0.6
      }
    }
  },
  "general": {
    "apps": {
      "terminal": ["kitty"],
      "audio": ["pavucontrol"],
      "playback": ["mpv"],
      "explorer": ["thunar"]
    },
    "idle": {
      "lockBeforeSleep": false,
      "inhibitWhenAudio": true,
      "inhibitWhenCharging": false,
      "timeouts": [
        {
          "timeout": 300,
          "idleAction": "dpms off",
          "returnAction": "dpms on"
        }
      ]
    }
  },
  "dashboard": {
    "resourceUpdateInterval": 3000,
    "performance": {
      "showGpu": false
    }
  },
  "services": {
    "gpuType": "None",
    "smartScheme": true,
    "defaultPlayer": "Spotify",
    "useFahrenheit": false,
    "useFahrenheitPerformance": false
  },
  "paths": {
    "wallpaperDir": "~/Pictures/Wallpapers"
  }
}
